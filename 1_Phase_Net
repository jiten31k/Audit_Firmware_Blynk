#include <WiFi.h>
#include <WiFiManager.h>
#include <WiFiClientSecure.h>
#include <ModbusMaster.h>
#include <PubSubClient.h>
#include <ArduinoOTA.h>
#include "secrets.h" 

#define RX_PIN 16
#define TX_PIN 17
#define MODBUS_ID 1
#define SERIAL_BAUD 4800
#define MQTT_MAX_PACKET_SIZE 512

ModbusMaster node;
WiFiClientSecure net;
PubSubClient awsIot(net);

#define DEVICE_SERIAL_NUMBER "001"   // Change this per ESP device

String deviceId   = "ENSN_" DEVICE_SERIAL_NUMBER;
String thingName  = deviceId;

String publishTopic   = thingName + "/pub";
String subscribeTopic = thingName + "/sub";

const unsigned long READ_INTERVAL = 10000;
unsigned long lastReadMillis = 0;

float voltageC = NAN, currentC = NAN, powerC = NAN, energyC = NAN, powerFactorC = NAN, frequency = NAN;
float voltageG = NAN, currentG = NAN, powerG = NAN, energyG = NAN, pfG = NAN;

void connectWiFi();
void connectAWS();
void readAll();
void setupOTA();

float readFloat32(uint16_t addr, float divisor) {
  uint8_t result = node.readHoldingRegisters(addr, 2);
  if (result == node.ku8MBSuccess) {
    uint32_t hi = node.getResponseBuffer(0);
    uint32_t lo = node.getResponseBuffer(1);
    uint32_t raw = ((uint32_t)hi << 16) | lo;
    return raw / divisor;
  }
  return NAN;
}

void mqttCallback(char* topic, byte* payload, unsigned int length) {
  Serial.print("Received on topic ");
  Serial.print(topic);
  Serial.print(": ");
  for (unsigned int i = 0; i < length; i++) Serial.print((char)payload[i]);
  Serial.println();
}

void connectAWS() {
  net.setCACert(AWS_IOT_ROOT_CA);
  net.setCertificate(AWS_IOT_DEVICE_CERT);
  net.setPrivateKey(AWS_IOT_PRIVATE_KEY);
  awsIot.setServer(AWS_IOT_ENDPOINT_ADDR, 8883);
  awsIot.setCallback(mqttCallback);
  awsIot.setBufferSize(MQTT_MAX_PACKET_SIZE);

  Serial.println("Connecting to AWS IoT...");
  while (!awsIot.connected()) {
    if (awsIot.connect(deviceId.c_str())) {
      awsIot.subscribe(subscribeTopic.c_str());
      Serial.println("Connected to AWS IoT!");
    } else {
      Serial.print("AWS connect failed, rc=");
      Serial.println(awsIot.state());
      delay(5000);
    }
  }
}

String getTimestampISO() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) return "";
  char buf[30];
  strftime(buf, sizeof(buf), "%Y-%m-%dT%H:%M:%S+05:30", &timeinfo);
  return String(buf);
}

void waitForTime() {
  Serial.print("Waiting for NTP time sync");
  struct tm timeinfo;
  while (!getLocalTime(&timeinfo)) {
    Serial.print(".");
    delay(500);
  }
  Serial.println(" Time synced!");
}

void readAll() {
  // ---- Channel 1: Consumption ----
  voltageC     = readFloat32(0x0048, 10000.0);
  currentC     = readFloat32(0x0049, 10000.0);
  powerC       = readFloat32(0x004A, 10000.0);
  energyC      = readFloat32(0x004B, 10000.0);
  powerFactorC = readFloat32(0x004C, 1000.0);
  frequency    = readFloat32(0x004F, 100.0);

  // ---- Channel 2: Generation ----
  voltageG     = readFloat32(0x0050, 10000.0);
  currentG     = readFloat32(0x0051, 10000.0);
  powerG       = readFloat32(0x0052, 10000.0);
  energyG      = readFloat32(0x0053, 10000.0);
  pfG          = readFloat32(0x0054, 1000.0);

  Serial.println("---- CH1: Consumption ----");
  Serial.printf("V: %.2f, I: %.3f, P: %.2f, kWh: %.3f, PF: %.3f, F: %.2f\n",
                voltageC, currentC, powerC, energyC, powerFactorC, frequency);

  Serial.println("---- CH2: Generation ----");
  Serial.printf("V: %.2f, I: %.3f, P: %.2f, kWh: %.3f, PF: %.3f, F: %.2f\n",
                voltageG, currentG, powerG, energyG, pfG, frequency);

  // ---- Create JSON Payload ----
  String timestampISO = getTimestampISO();
  char payload[512];

  snprintf(payload, sizeof(payload),
           "{\"deviceId\":\"%s\",\"timestamp\":\"%s\","
           "\"CN\":{\"V\":%.2f,\"I\":%.3f,\"P\":%.2f,\"kWh\":%.3f,\"PF\":%.3f,\"F\":%.2f},"
           "\"GN\":{\"V\":%.2f,\"I\":%.3f,\"P\":%.2f,\"kWh\":%.3f,\"PF\":%.3f,\"F\":%.2f}}",
           deviceId.c_str(), timestampISO.c_str(),
           voltageC, currentC, powerC, energyC, powerFactorC, frequency,
           voltageG, currentG, powerG, energyG, pfG, frequency);

  // ---- Publish to AWS ----
  if (awsIot.connected()) {
    if (awsIot.publish(publishTopic.c_str(), payload)) {
      Serial.println("Publish SUCCESS");
    } else {
      Serial.println("Publish FAILED");
    }
  } else {
    Serial.println("AWS not connected, reconnecting...");
    connectAWS();
  }

  Serial.println(payload);
}

// -------------------- WIFI CONNECTION --------------------
void connectWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.setHostname(deviceId.c_str());
  WiFiManager wm;
  wm.setConnectTimeout(30);
  wm.setConfigPortalTimeout(180);

  if (!wm.autoConnect(WIFI_AP_SSID, WIFI_AP_PASSWORD)) {
    Serial.println("WiFi connection failed. Restarting...");
    ESP.restart();
  } else {
    Serial.println("WiFi connected!");
  }
}

// -------------------- OTA SETUP --------------------
void setupOTA() {
  ArduinoOTA.setHostname("EnergInAI-OTA");
  ArduinoOTA.setPassword("energinai@123");

  ArduinoOTA.onStart([]() {
    Serial.println("Start OTA update...");
  });
  ArduinoOTA.onEnd([]() {
    Serial.println("\nOTA Update Finished!");
  });
  ArduinoOTA.onProgress([](unsigned int progress, unsigned int total) {
    Serial.printf("Progress: %u%%\r", (progress / (total / 100)));
  });
  ArduinoOTA.onError([](ota_error_t error) {
    Serial.printf("OTA Error[%u]\n", error);
  });

  ArduinoOTA.begin();
  Serial.println("OTA Ready.");
}

// -------------------- SETUP --------------------
void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println("\n Booting...");

  connectWiFi();
  setupOTA();

  Serial2.begin(SERIAL_BAUD, SERIAL_8N1, RX_PIN, TX_PIN);
  node.begin(MODBUS_ID, Serial2);

  configTime(0, 0, "pool.ntp.org");
  waitForTime();

  connectAWS();
  lastReadMillis = millis();
}

// -------------------- MAIN LOOP --------------------
void loop() {
  ArduinoOTA.handle();   // Handle OTA updates

  if (WiFi.status() != WL_CONNECTED) connectWiFi();
  if (!awsIot.connected()) connectAWS();

  unsigned long now = millis();
  if (now - lastReadMillis >= READ_INTERVAL) {
    lastReadMillis = now;
    readAll();
  }

  awsIot.loop();
}
